# See docs/Task1/README.md.
BIONICPRO_AUTH_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
# Temporary exception for the localhost HTTP stand only. Use true behind HTTPS.
COOKIE_SECURE=false
# Optional with base Compose; Task2 override sets the internal reports-api URL.
REPORTS_API_URL=
# Generate each LDAP password with openssl rand -hex 32.
LDAP_ADMIN_PASSWORD=
LDAP_CONFIG_PASSWORD=
LDAP_READONLY_PASSWORD=
# Yandex OAuth application: login:info and login:email; credentials remain server-side.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Generate with openssl rand -hex 32 (URL-safe).
PROFILES_DB_PASSWORD=
# Task2 reports stand. Generate separate URL-safe passwords: openssl rand -hex 32.
SOURCES_DB_PASSWORD=
ETL_DB_PASSWORD=
CLICKHOUSE_ETL_PASSWORD=
CLICKHOUSE_READER_PASSWORD=
AIRFLOW_DB_PASSWORD=
AIRFLOW_WEBSERVER_SECRET_KEY=
AIRFLOW_ADMIN_PASSWORD=
# Separate Fernet key: openssl rand -base64 32.
AIRFLOW_FERNET_KEY=
# Task3: отдельные секреты, каждый генерируется через openssl rand -hex 32.
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=
REPORTS_S3_SECRET_KEY=
ETL_S3_SECRET_KEY=
CDN_SIGNING_SECRET=
# Task4 CDC: отдельный пароль роли Debezium, openssl rand -hex 32.
CDC_DB_PASSWORD=
